# Persistent database path on the server. Keep it outside client/dist.
EXPERIMENT_DB_PATH=/var/lib/commentscope/experiment.sqlite3

# Admin web login. Change these before public deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Required only for legacy researcher scripts and compatible admin endpoints.
RESEARCHER_ADMIN_TOKEN=replace-with-a-long-random-secret

# Production server settings.
PORT=8888
CORS_ORIGIN=https://experiment.example.org
CLIENT_DIST_PATH=/var/www/commentscope/client/dist
